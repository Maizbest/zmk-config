#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

#define DEF 0
#define LWR 1
#define RSE 2
#define ADJ 3

&lt { quick_tap_ms = <200>; };

&mt { quick_tap_ms = <200>; };

/ {
    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
  &kp ESCAPE  &kp N1  &kp N2    &kp N3    &kp N4       &kp N5        &kp N6      &kp N7       &kp N8           &kp N9    &kp N0    &kp BACKSPACE
  &kp TAB     &kp Q   &kp W     &kp E     &kp R        &kp T         &kp Y       &kp U        &kp I            &kp O     &kp P     &kp BACKSLASH
  &kp LSHIFT  &kp A   &kp S     &kp D     &kp F        &kp G         &kp H       &kp J        &kp K            &kp L     &kp SEMI  &kp SINGLE_QUOTE
  &kp LCTRL   &kp Z   &kp X     &kp C     &kp V        &kp B         &kp N       &kp M        &kp COMMA        &kp DOT   &kp FSLH  &kp RSHIFT
                      &kp LGUI  &kp LALT  &lt 1 SPACE  &kp LSHIFT    &kp RSHIFT  &lt 2 ENTER  &lt 1 RIGHT_ALT  &kp RGUI
            >;
        };

        lower_layer {
            bindings = <
  &kp TILDE       &kp LS(NUMBER_1)  &kp LS(NUMBER_2)  &kp LS(NUMBER_3)  &kp LS(NUMBER_4)  &kp LS(NUMBER_5)    &kp LS(NUMBER_6)  &kp LS(NUMBER_7)      &kp LS(NUMBER_8)       &kp LS(NUMBER_9)  &kp LS(NUMBER_0)  &kp DELETE
  &kp GRAVE       &kp F1            &kp F2            &kp F3            &kp F4            &none               &none             &kp LS(LEFT_BRACKET)  &kp LS(RIGHT_BRACKET)  &kp LS(MINUS)     &kp LS(EQUAL)     &kp LS(BACKSLASH)
  &kp LEFT_SHIFT  &kp F5            &kp F6            &kp F7            &kp F8            &none               &trans            &kp LEFT_BRACKET      &kp RIGHT_BRACKET      &kp MINUS         &kp EQUAL         &kp LS(SINGLE_QUOTE)
  &trans          &kp F9            &kp F10           &kp F11           &kp F12           &none               &trans            &trans                &kp LS(COMMA)          &kp LS(PERIOD)    &kp LS(SLASH)     &trans
                                    &trans            &trans            &trans            &trans              &trans            &trans                &trans                 &trans
            >;
        };

        raise_layer {
            bindings = <
  &trans      &kp F1           &kp F2     &kp F3     &kp F4     &kp F5          &kp F6    &kp F7     &kp F8     &kp F9     &kp F10  &kp DELETE
  &kp KP_NUM  &kp DEL          &kp DEL    &kp DEL    &kp DEL    &kp KP_MINUS    &none     &kp HOME   &kp END    &none      &none    &kp INSERT
  &kp LSHFT   &kp KP_MULTIPLY  &kp KP_N4  &kp KP_N5  &kp KP_N6  &kp KP_PLUS     &kp LEFT  &kp DOWN   &kp UP     &kp RIGHT  &kp INS  &kp RSHFT
  &kp LCTRL   &kp KP_N0        &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_DOT      &none     &kp PG_DN  &kp PG_UP  &kp MINUS  &none    &kp RCTRL
                               &trans     &trans     &none      &none           &trans    &trans     &to 3      &trans
            >;
        };

        adjust_layer {
            bindings = <
  &none        &none  &none  &none   &none  &none     &none         &none         &none         &none         &none         &none
  &bootloader  &none  &none  &none   &none  &none     &none         &none         &none         &none         &none         &bootloader
  &none        &none  &none  &none   &none  &none     &bt BT_SEL 4  &bt BT_SEL 3  &bt BT_SEL 2  &bt BT_SEL 1  &bt BT_SEL 0  &bt BT_CLR
  &sys_reset   &none  &none  &none   &none  &none     &none         &none         &none         &none         &none         &sys_reset
                      &none  &trans  &none  &trans    &trans        &none         &trans        &none
            >;
        };
    };
};
